APP_NAME=Pixel AI Office API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/pixel_ai_office_db

# AI Provider Configuration (TASK 11)
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_OUTPUT_TOKENS=2048
